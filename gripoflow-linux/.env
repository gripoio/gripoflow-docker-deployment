# Nginx env
LISTEN_PORT=5055
API_BACKEND=http://flow-backend:5001
WORKFLOW_FRONTEND=http://flow-frontend:3000

# Data layer
DB_CONNECTION_STRING=mongodb://flow-db:27017
TEMPORAL_SERVER_URL=temporal:7233
REDIS_URL=flow-redis:6379
SERVER_IP=0.0.0.0:5001

# Sandbox 
SANDBOX_WORKER_IMAGE=gripo/flow-sandbox-worker:1.0.0-alpha.1
GRPC_XDS_BOOTSTRAP=xds_bootstrap.json
DOCKER_HOST=tcp://flow-proxy:2375     
WORKER_HEALTH_INTERVAL=160
DOCKER_NETWORK=gripo-flow
XDS_SERVER_IP=18000
SSH_PORT=9091

# Deployment
DEPLOYED_ENVIRONMENT=docker
KUBERNETES_NAMESPACE=default
KUBERNETES_STORAGE_CLASS=nfs-client

# Click house 
CLICKHOUSE_ADDRESS=clickhouse-analysis:9000
CLICKHOUSE_DB=gripo-flow
CLICKHOUSE_USER=gripo
CLICKHOUSE_PASSWORD=gripo123


